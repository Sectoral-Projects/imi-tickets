{
    "name":  "@imi/tickets-bot",
    "version":  "0.0.1",
    "main":  "dist/index.js",
    "author":  "IImothy",
    "license":  "MIT",
    "type":  "commonjs",
    "dependencies":  {
                         "@hono/node-server":  "^2.0.8",
                         "@sapphire/decorators":  "^6.2.0",
                         "@sapphire/discord.js-utilities":  "7.3.2",
                         "@sapphire/framework":  "^5.5.0",
                         "@sapphire/plugin-logger":  "^4.1.0",
                         "@sapphire/utilities":  "^3.18.2",
                         "@skyra/env-utilities":  "^1.3.0",
                         "better-auth":  "^1.6.23",
                         "better-sqlite3":  "^12.11.1",
                         "colorette":  "^2.0.20",
                         "discord.js":  "^14.26.5",
                         "dotenv":  "^17.4.2",
                         "drizzle-orm":  "^0.45.2",
                         "hono":  "^4.12.29",
                         "mustache":  "^4.2.0",
                         "ws":  "^8.21.0",
                         "@imi/tickets-shared":  "workspace:*"
                     },
    "devDependencies":  {
                            "@sapphire/cli":  "^1.9.3",
                            "@sapphire/prettier-config":  "^2.0.0",
                            "@sapphire/ts-config":  "^5.0.3",
                            "@types/better-sqlite3":  "^7.6.13",
                            "@types/mustache":  "^4.2.6",
                            "@types/node":  "^22.20.1",
                            "@types/ws":  "^8.18.1",
                            "drizzle-kit":  "^0.31.10",
                            "prettier":  "^3.9.5",
                            "tsc-alias":  "^1.9.0",
                            "tsc-watch":  "^6.3.1",
                            "tsx":  "^4.23.0",
                            "typescript":  "~6.0.3"
                        },
    "scripts":  {
                    "sapphire":  "sapphire",
                    "generate":  "sapphire generate",
                    "build":  "node -e \"require(\u0027fs\u0027).rmSync(\u0027dist\u0027,{recursive:true,force:true})\" \u0026\u0026 tsc \u0026\u0026 tsc-alias",
                    "watch":  "tsc -w",
                    "start":  "node dist/index.js",
                    "dev":  "pnpm run build \u0026\u0026 pnpm run start",
                    "watch:start":  "tsc-watch --onSuccess \"pnpm run start\"",
                    "format":  "prettier --write \"src/\"",
                    "db:migrate":  "drizzle-kit migrate",
                    "db:push":  "drizzle-kit push",
                    "db:generate":  "drizzle-kit generate"
                },
    "prettier":  "@sapphire/prettier-config"
}

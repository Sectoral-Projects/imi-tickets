# Discord Bot
TOKEN=your-discord-bot-token

# API Server
HOST=0.0.0.0
PORT=4000
# Local Vite UI and Docker web UI both default to http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SQLite (local path is relative to apps/bot)
# Docker uses DOCKER_DATABASE_FILE (default /app/data/data.db) instead
DATABASE_FILE=src/database/sqlite/data.db
# DOCKER_DATABASE_FILE=/app/data/data.db
# DATA_DIR=./data
# WEB_PORT=5173
# WEB_CONTAINER_PORT=80

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-string
BETTER_AUTH_URL=http://localhost:4000

# Discord OAuth (web login)
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Web dashboard (baked into the Vite build; Docker compose also reads this)
VITE_API_URL=http://localhost:4000
